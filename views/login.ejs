<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام تسجيل الدخول</title>
    <style>
        :root {
            --primary-color: #2c3e50;
            --primary-hover: #1a252f;
            --danger-color: #e74c3c;
            --warning-color: #ffc107;
            --text-color: #343a40;
            --light-gray: #e9ecef;
            --border-color: #ced4da;
        }
        
        body {
            font-family: 'Tajawal', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: var(--text-color);
            line-height: 1.6;
        }
        
        .login-container {
            background: white;
            padding: 2.5rem;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
            text-align: center;
            transition: all 0.3s ease;
            margin: 1rem;
        }
        
        h1 {
            color: var(--primary-color);
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }
        
        .alert {
            padding: 1rem;
            margin-bottom: 1.5rem;
            border-radius: 6px;
            text-align: center;
            border-right: 4px solid transparent;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border-right-color: #dc3545;
        }
        
        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border-right-color: var(--warning-color);
        }
        
        .form-group {
            margin-bottom: 1.5rem;
            text-align: right;
        }
        
        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #495057;
        }
        
        input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 1rem;
            transition: all 0.3s ease;
            font-family: 'Tajawal', sans-serif;
        }
        
        input:focus {
            border-color: #3498db;
            outline: none;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
        }
        
        input:disabled {
            background-color: var(--light-gray);
            cursor: not-allowed;
        }
        
        button {
            width: 100%;
            padding: 0.75rem;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: background-color 0.3s ease;
            margin-top: 0.5rem;
            font-family: 'Tajawal', sans-serif;
        }
        
        button:hover:not(:disabled) {
            background-color: var(--primary-hover);
        }
        
        button:disabled {
            background-color: #95a5a6;
            cursor: not-allowed;
        }
        
        .countdown {
            font-weight: bold;
            color: var(--danger-color);
            font-size: 1.2rem;
        }
        
        .attempts-info {
            margin-top: 1rem;
            font-size: 0.9rem;
            color: #7f8c8d;
        }
        
        .attempts-count {
            font-weight: bold;
            color: var(--danger-color);
        }
        
        @media (max-width: 480px) {
            .login-container {
                padding: 1.5rem;
            }
            
            h1 {
                font-size: 1.5rem;
            }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="login-container">
        <h1>تسجيل الدخول إلى النظام</h1>
        
        <% if (error) { %>
            <div class="alert <%= blocked ? 'alert-warning' : 'alert-danger' %>">
                <%= error %>
                <% if (blocked) { %>
                    <p>الوقت المتبقي: <span id="countdown" class="countdown"><%= remainingTime %></span> ثانية</p>
                <% } else { %>
                    <div class="attempts-info">
                        عدد المحاولات: <span class="attempts-count"><%= attempts %></span> من 3
                    </div>
                <% } %>
            </div>
        <% } %>
        
        <form action="/login" method="POST" id="loginForm">
            <div class="form-group">
                <label for="username">اسم المستخدم:</label>
                <input type="text" id="username" name="username" required <%= blocked ? 'disabled' : '' %>>
            </div>
            <div class="form-group">
                <label for="password">كلمة المرور:</label>
                <input type="password" id="password" name="password" required <%= blocked ? 'disabled' : '' %>>
            </div>
            <button type="submit" <%= blocked ? 'disabled' : '' %>>
                <%= blocked ? 'الحساب محظور مؤقتاً' : 'تسجيل الدخول' %>
            </button>
        </form>
    </div>

    <% if (blocked) { %>
        <script>
            // عد تنازلي للوقت المتبقي
            let timeLeft = <%= remainingTime %>;
            const countdownElement = document.getElementById('countdown');
            const loginForm = document.getElementById('loginForm');
            const inputs = loginForm.querySelectorAll('input');
            const submitButton = loginForm.querySelector('button');
            
            const countdownInterval = setInterval(() => {
                timeLeft--;
                countdownElement.textContent = timeLeft;
                
                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    // تمكين الحقول عند انتهاء المدة
                    inputs.forEach(input => input.disabled = false);
                    submitButton.disabled = false;
                    submitButton.textContent = 'تسجيل الدخول';
                    // إعادة تحميل الصفحة تلقائياً بعد ثانية
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                }
            }, 1000);
        </script>
        <% } %>
</body>
</html>